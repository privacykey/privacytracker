# Published app image to run. `latest` is the newest release, never a
# prerelease or an unreleased build; pin a version (for example 0.3.0) for
# repeatable deployments.
PRIVACYTRACKER_IMAGE=ghcr.io/privacykey/privacytracker:latest

# Hostname Caddy should serve. Use a LAN DNS name, mDNS name, or a real domain.
PRIVACYTRACKER_HOST=privacytracker.localhost

# Required: Compose will not start without it. Generate a long random value
# (for example `openssl rand -hex 32`) and sign in with the same token.
AUDITOR_ADMIN_TOKEN=
